# ─────────────────────────────────────────────────────────────
# EsyLuban 子树忽略规则
#
# 本文件是【新增文件】，规则只作用于 esyluban/ 子树。
# 上游根目录的 .gitignore 一字未改 —— 这是本 fork「对上游零改动」
# 性质的一部分：需要新规则时新增分层 .gitignore，而不是修改上游的。
# ─────────────────────────────────────────────────────────────

# Luban 运行时（60+ 个二进制）。由 scripts/build.bat 从 ../src 构建产出。
# 不进版本控制：二进制每次重建都会产生新 blob，会让仓库历史不可逆地膨胀。
runtime/

# self-contained 构建（scripts/build.bat --self-contained），约 76MB
runtime-sc/

# 回归测试产物：每次 scripts/test/run_full_tests_example.bat 都会重写
examples/dev/TestOutputs/
# release 工程的回归导出暂存区。它导到这里、再与 Assets 下【已提交】的
# 生成物比对 —— 那份提交内容才是基线，所以暂存区本身不进版本控制。
examples/release/TestOutputs/
# 硬失败负例（重复主键、mode=one 多行）的运行日志。这些用例本来就要中止，
# 日志只用于断言「是因为那条错误中止的」，不是资产。
examples/negatives_hard/TestOutputs/

# 发布包暂存与产物：scripts/release/make_release.bat 组装出来的，
# 内容全部是 runtime/ 与 templates/ 的副本，没有一份是原始资产。
dist/

# Python 字节码缓存（scripts/authoring/ 下的工具与测试会产生）
__pycache__/
*.pyc

# ── 取消上游规则对本子树的误伤 ──────────────────────────────
# 上游 .gitignore 第 18 行的 [Rr]elease/ 是 .NET 生态用来忽略 Release 构建
# 目录的通用规则，它匹配【任意层级】的 release 目录，而不只是 bin/Release。
# 本子树里凡是叫 release 的目录都会被整个吞掉，且 git 不给任何提示。
#
# 已经咬过两次：
#   examples/release/   示例工程，785 个文件静默丢失
#   scripts/release/    发布打包脚本，3 个文件静默丢失
#
# 因此这里**不再逐个补否定规则**，而是取消该规则对整个子树的作用。
# 真正的 .NET 构建产物由 bin/ obj/ 规则覆盖，本子树内不存在需要靠
# [Rr]elease/ 忽略的东西。
#
# 跟进上游后值得复检（应当无输出）：
#   git check-ignore -v esyluban/scripts/release/make_release.bat
#   git check-ignore -v esyluban/examples/release/Tools/Luban/luban.conf
# scripts/test/check_gitignore_traps.bat 会在回归里自动做这个检查。
!release/
!**/release/

# 注意：examples/release 下 Unity 工程的生成物（Assets/GenCode、Assets/GenData）
# 【刻意保留】进版本控制 —— 它们是"发布示例"的展示内容，用于说明生成结果的样子；
# 且 Unity 要求 .meta 与资源一一对应，忽略后工程会报缺失。
